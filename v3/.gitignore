# 依赖与构建产物
node_modules/
dist/

# 运行时目录：内容不入库，但保留 .gitkeep 占位
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep

# 备份与客户端构建输出（client 构建产物输出到 server/public/）
backups/
server/public/

# E2E（Playwright）：临时数据目录 / 登录态 / 报告与痕迹
client/.e2e-data/
client/test-results/
client/playwright-report/

# 日志与杂项
*.log
.DS_Store

# 安卓壳（mobile/）：依赖与构建产物不入库；android/ 工程模板与配置入库
mobile/node_modules/
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/build/
mobile/android/local.properties
mobile/android/capacitor-cordova-android-plugins/
